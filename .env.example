# ---- Runtime ----
APP_ENV=development
SIGNAL_ONLY=true
DB_PATH=data/fortress_fx.sqlite3
LOG_LEVEL=INFO

# ---- OANDA v20 ----
# practice or live. Start with practice.
OANDA_ENV=practice
OANDA_TOKEN=
OANDA_ACCOUNT_ID=
OANDA_REST_URL=https://api-fxpractice.oanda.com
OANDA_STREAM_URL=https://stream-fxpractice.oanda.com

# ---- Phone alerts ----
# Default: email. Telegram remains available as an optional fallback.
ALERT_CHANNEL=email

# Email uses authenticated SMTP with STARTTLS.
# For a Gmail sender, use your Gmail address and a Google app password.
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=
EMAIL_APP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# Optional Telegram fallback. Required only when ALERT_CHANNEL=telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Scanner ----
INSTRUMENTS=EUR_USD,GBP_USD,USD_JPY
GRANULARITIES=M15,H1
CANDLE_COUNT=300
SCAN_INTERVAL_SECONDS=60

# ---- Signal quality / risk gates ----
MIN_CONFIDENCE=70
MAX_SPREAD_PIPS=2.0
MIN_REWARD_RISK=1.50
MAX_ALERTS_PER_DAY=8
ALERT_DEDUP_MINUTES=120
MAX_CANDLE_AGE_SECONDS=900

# ---- Conservative evaluation assumptions ----
BACKTEST_SPREAD_PIPS=1.2
BACKTEST_SLIPPAGE_PIPS=0.2
RISK_PER_TRADE_PCT=0.25
